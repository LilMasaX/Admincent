# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# NextAuth (Auth.js v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
# AUTH_URL is auto-detected on Vercel; set explicitly only when needed.
# AUTH_URL=http://localhost:3000

# Resend (email delivery)
RESEND_API_KEY=re_...
RESEND_FROM=desprendibles@centicsas.com.co

# iLovePDF (DOCX → PDF conversion for certificates)
# Get your key at: https://developer.ilovepdf.com
# Free tier: 250 files/month. Leave blank to skip PDF conversion (downloads as DOCX).
ILOVEPDF_PUBLIC_KEY=project_public_...
